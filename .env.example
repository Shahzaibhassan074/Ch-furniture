# ----- NextAuth -----
# Generate NEXTAUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXTAUTH_URL must be your full domain in production (no trailing slash).
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="https://chfurniturehouse.com"

# ----- Admin account -----
# ADMIN_EMAIL is read at RUNTIME by the forgot-password endpoint to validate requests.
# ADMIN_NAME is used only by the setup script (scripts/setup-admin.mjs).
# ADMIN_PASSWORD is optional — the setup script will prompt interactively if not set.
ADMIN_EMAIL="your-email@gmail.com"
ADMIN_NAME="CH Furniture Admin"
# ADMIN_PASSWORD=""   # Optional: only used by setup script, never by the server at runtime

# ----- Cloudinary -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET is no longer used — uploads are now signed server-side.
# Delete or disable the "ch_furniture_unsigned" preset in your Cloudinary dashboard.

# ----- Public site URL (sitemap, OG, canonical, password-reset links) -----
NEXT_PUBLIC_SITE_URL="https://chfurniturehouse.com"

# ----- Email — Resend (password reset) -----
# Free at resend.com — sign up, go to API Keys, create one, paste it here.
RESEND_API_KEY="re_your_api_key_here"
# EMAIL_FROM: the "from" address for password-reset emails.
# Use "Your Name <noreply@yourdomain.com>" after verifying the domain in Resend.
# IMPORTANT: until the domain is verified, ADMIN_EMAIL must equal the Resend account email.
# Defaults to onboarding@resend.dev (Resend sandbox) if not set.
EMAIL_FROM="CH Furniture House <noreply@chfurniturehouse.com>"

# ----- Email — Gmail SMTP (contact form notifications) -----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
OWNER_EMAIL="your-gmail@gmail.com"

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
